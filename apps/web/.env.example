# URL của Backend PocketBase (Ở local mặc định Vite đã tự động proxy /hcgi/platform về http://127.0.0.1:8090)
# Khi deploy lên host thật nếu dùng PocketBase riêng thì điền URL vào đây, ví dụ:
# VITE_POCKETBASE_URL=https://api.zikzak.vn

# (Tùy chọn) Nếu bạn muốn gửi trực tiếp dữ liệu Form đăng ký tư vấn về Google Sheets / Email Webhook
# mà không cần chạy máy chủ PocketBase khi deploy, hãy điền link Webhook (Google Apps Script / Formspree) vào đây:
# VITE_FORM_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
